[Unit]
Description=Admin Dashboard (Next.js)
After=network.target backend-api.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/app/admin-next
ExecStart=/usr/bin/node node_modules/.bin/next start -p 3000
Restart=always
RestartSec=5
StartLimitBurst=5
StartLimitIntervalSec=60

Environment=NODE_ENV=production
Environment=PORT=3000
EnvironmentFile=/var/www/app/admin-next/.env

LimitNOFILE=65535

StandardOutput=journal
StandardError=journal
SyslogIdentifier=admin-next

[Install]
WantedBy=multi-user.target
