# ─── Required ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=admin-mainbeta

# ─── Optional ─────────────────────────────────────────────────────────────────
PORT=5001
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
ALLOWED_ORIGINS=
UPLOAD_DIR=
PRIMARY_DOMAIN=

# ─── ImageKit (server-side auth for client uploads) ───────────────────────────
# All three are required for the /api/v1/upload-auth endpoint to work.
# The PRIVATE KEY must never be exposed to the frontend.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
